{
  "name": "mozu-quote-bot",
  "version": "1.0.0",
  "description": "見積もりアシスタントBot - テキストやPDFで依頼を受けて金額・納期・在庫を調査",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src/",
    "scrape": "ts-node src/scrape-cli.ts",
    "scrape:only": "ts-node src/scrape-cli.ts --scrape-only",
    "scrape:build": "ts-node src/scrape-cli.ts --build-only",
    "scrape:stats": "ts-node src/scrape-cli.ts --stats",
    "recommend": "ts-node src/scrape-cli.ts --recommend"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.0",
    "@slack/bolt": "^4.1.0",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^16.4.0",
    "googleapis": "^144.0.0",
    "openai": "^4.70.0",
    "pdf-parse": "^1.1.1",
    "playwright-core": "^1.56.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.0"
  }
}
